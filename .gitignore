###############################################################################
# .gitignore — Smart IoT Based Water & Electricity Monitoring Monorepo
# Covers: Node.js / TypeScript, Next.js, Python, Arduino / PlatformIO,
#         Docker, PostgreSQL, VS Code, IntelliJ, Windows, macOS, Linux
###############################################################################


# =============================================================================
# ENVIRONMENT & SECRETS
# Never commit credentials, API keys, or environment-specific configuration.
# =============================================================================

.env
.env.*
!.env.example          # Always keep the example template in version control
*.pem
*.key
*.cert
*.p12
*.pfx
secrets/
credentials/


# =============================================================================
# NODE.JS / NPM / YARN / PNPM
# =============================================================================

# Dependency directories — always reinstalled via package.json
node_modules/

# NPM package locks (keep package-lock.json or yarn.lock, not both)
# Uncomment the one you do NOT use:
# package-lock.json
# yarn.lock

# PNPM
.pnpm-store/
pnpm-debug.log*

# NPM debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Yarn v2+ (Berry) — keep .yarn/releases and .yarn/plugins in source control
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/.gitignore


# =============================================================================
# TYPESCRIPT
# =============================================================================

# Compiled JavaScript output — regenerated by `tsc` or the build tool
dist/
build/
out/

# TypeScript incremental compilation cache
*.tsbuildinfo

# Type declaration maps generated alongside .d.ts files
# (keep only if publishing a library)
# *.d.ts


# =============================================================================
# NEXT.JS (frontend)
# =============================================================================

# Next.js build output
frontend/.next/
frontend/out/

# Next.js cache
frontend/.next/cache/

# Next.js static export
frontend/next-env.d.ts

# Vercel deployment metadata
.vercel


# =============================================================================
# PYTHON (future analytics / ML scripts)
# =============================================================================

# Byte-compiled / optimised / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
eggs/
.eggs/
dist/
downloads/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments — never commit the venv itself
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Pipenv / Poetry / PDM lockfiles (optional — keep if you want reproducible builds)
# Pipfile.lock
# poetry.lock

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# Spyder project settings
.spyderproject.db
.spyproject

# PyCharm
.idea/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff / flake8 caches
.ruff_cache/


# =============================================================================
# ARDUINO / PLATFORMIO (firmware)
# =============================================================================

# PlatformIO build artifacts — rebuilt by `pio run`
firmware/.pio/

# PlatformIO project workspace cache
firmware/.pioenvs/

# PlatformIO libdeps — downloaded automatically
firmware/.pio/libdeps/

# Arduino IDE build cache (Windows: %TEMP%, macOS: /var/folders)
# The IDE writes sketch build artefacts to a system temp directory by default.
# If you have configured a local build dir inside the project, add it here:
firmware/build/

# Compiled Arduino binaries
*.hex
*.bin
*.elf
*.map

# Arduino IDE v2 cache
.arduino15/


# =============================================================================
# DOCKER
# =============================================================================

# Docker override files — used for local customisations that should not be shared
docker-compose.override.yml
docker-compose.local.yml
docker-compose.*.local.yml

# Docker context artefacts
.dockerignore.local


# =============================================================================
# POSTGRESQL DUMPS & DATA FILES
# =============================================================================

# Database dump files — may contain sensitive data
*.sql
!backend/prisma/migrations/**/*.sql
*.dump
*.pgdump
*.bak

# Prisma migration env override
prisma/.env

# Local Prisma SQLite dev database (if ever used for local testing)
*.db
*.db-journal


# =============================================================================
# LOGS
# =============================================================================

# Application logs (Winston, Morgan, etc.)
logs/
*.log
*.log.*

# PM2 log files
.pm2/
pm2.log

# Mosquitto broker logs (mounted volume, but in case of local runs)
mosquitto/log/
docker/mosquitto/log/


# =============================================================================
# RUNTIME & PROCESS FILES
# =============================================================================

# PID files
*.pid
*.seed
*.pid.lock

# Coverage directory used by testing tools
coverage/
*.lcov
.nyc_output/

# Grunt intermediate storage
.grunt

# Bower components
bower_components/


# =============================================================================
# VS CODE
# =============================================================================

# VS Code workspace settings — keep extensions.json and recommended settings,
# but ignore user-specific or machine-specific overrides.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json      # Remove this line if settings differ per developer
!.vscode/tasks.json
!.vscode/launch.json
.vscode-test/


# =============================================================================
# INTELLIJ IDEA / WEBSTORM / PYCHARM (JetBrains IDEs)
# =============================================================================

.idea/
*.iws
*.iml
*.ipr
out/
.idea_modules/


# =============================================================================
# WINDOWS OS FILES
# =============================================================================

# Thumbnail cache files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Dump file
*.stackdump

# Windows Folder Config
[Dd]esktop.ini

# Windows shortcuts
*.lnk

# Windows Recycle Bin
$RECYCLE.BIN/

# Windows installer files
*.cab
*.msi
*.msix
*.msm
*.msp


# =============================================================================
# MACOS FILES
# =============================================================================

# General
.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk


# =============================================================================
# LINUX / UNIX FILES
# =============================================================================

*~

# Temporary files which can be created if a process still has a file open
.fuse_hidden*

# KDE directory preferences
.directory

# Linux trash folder (appears on desktops, not root)
.Trash-*

# .nfs files created when an open file is removed but is still being accessed
.nfs*


# =============================================================================
# MISCELLANEOUS
# =============================================================================

# Terraform (if infrastructure-as-code is ever added)
*.tfstate
*.tfstate.*
.terraform/

# Compiled binary addons (from `node-gyp`)
build/Release

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Sentry CLI config
.sentryclirc

# Local testing artefacts
test-results/
playwright-report/
